# Copy this file to `.env` (in this backend/ folder) and fill in what you have.
# Both API keys are OPTIONAL — the application tracker works without them.
# You only need them for the AI features (resume parsing/tailoring, match
# scoring) and job recommendations.

# Claude API key — powers resume parsing, tailoring, and match scoring.
# Get one at https://console.anthropic.com (create an API key, then buy the
# $5 minimum credit block — that goes a long way at this app's usage).
ANTHROPIC_API_KEY=

# JSearch API key — powers the job recommendations feed.
# Get one at https://rapidapi.com (search for "JSearch", subscribe to the
# free tier: 200 requests/month, no credit card required).
JSEARCH_API_KEY=

# Where the SQLite database file lives, relative to backend/.
# The default is fine; the file is git-ignored so your data stays private.
DATABASE_PATH=backend-local.db
